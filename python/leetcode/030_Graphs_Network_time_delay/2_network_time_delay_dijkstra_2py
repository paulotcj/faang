# https://leetcode.com/problems/network-delay-time/description/

import heapq
from collections import defaultdict

#-------------------------------------------------------------------------
class Solution :
    #-------------------------------------------------------------------------
    def networkDelayTime(self, times: list[list[int]], n: int, k: int) -> int:
        # Build the graph as an adjacency list
        adj_list : defaultdict[ int , list[int]] = defaultdict(list) # any key not present, the default value is a list

        #----------------------------------------
        for from_node , to_node , time_needed in times :
            adj_list[from_node].append( [to_node , time_needed] )
        #----------------------------------------

        min_heap : list[list[int]] = [ [k , 0] ] # Min-heap to store [node , time]

        time_required_dict : dict[int,int] = {} # dictionary to store the shortest time to reach each node

        #----------------------------------------
        while min_heap :
            curr_node , curr_node_time = heapq.heappop( min_heap )

            if curr_node in time_required_dict : continue # if the node is already visited, skip it

            time_required_dict[curr_node] = curr_node_time # record the shortest time to reach this node


            #----------------------------------------
            for to_node , to_node_time in adj_list[curr_node] :
                if to_node in time_required_dict : continue # if the node is already visited, skip it
                new_time : int = to_node_time + curr_node_time
                heapq.heappush( min_heap , [to_node, new_time] )
            #----------------------------------------
        #----------------------------------------

        max_time : int = max(time_required_dict.values())

        result : int = max_time if len(time_required_dict) == n else -1

        return result
    #-------------------------------------------------------------------------
#-------------------------------------------------------------------------
