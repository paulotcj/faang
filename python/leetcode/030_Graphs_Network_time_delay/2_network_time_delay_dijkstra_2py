# https://leetcode.com/problems/network-delay-time/description/

import heapq
from collections import defaultdict

#-------------------------------------------------------------------------
class Solution :
    #-------------------------------------------------------------------------
    def networkDelayTime(self, times: list[list[int]], n: int, k: int) -> int:
        # Build the graph as an adjacency list
        adj_list : defaultdict[ int , list[int]] = defaultdict(list) # any key not present, the default value is a list

        #----------------------------------------
        for from_node , to_node , time_needed in times :
            adj_list[from_node].append( [to_node , time_needed] )
        #----------------------------------------

        min_heap : list[list[int]] = [ [0, k] ] # Min-heap to store [time , node] - it needs to be in this order unfortunately

        time_required_dict : dict[int,int] = {} # dictionary to store the shortest time to reach each node

        #----------------------------------------
        while min_heap :
            curr_node_time , curr_node  = heapq.heappop( min_heap )

            ''' this part is super tricky and absolutely not obvious at first glance. The initial thinking process is that
            there might be other paths found later that can be shorter. But you have to remember that we are poping the
            accumulated shortest path until now. And given the greedy approach os this algo this is not possible. Let's 
            imagine a graph where you have: 
              A -> B = 6 
            And then you have 
              A -> C = 1   ,   C -> D = 2   ,   D -> B = 1  | Total Distance: A -> C -> D -> B = 4 
            but if you consider the priority queue nature, the path A -> B will only be explored AFTER all the other 
            alternatives as they are all smaller. And if we were to change the last leg of this path as D -> B = 5
            the priority queue would pop first the path A -> B, because A -> B = 6 but the accumulated distance/time 
            that D -> B introduces is: 
              A -> C = 1   ,   C -> D = 2   ,   D -> B = 5  | Total Distance: A -> C -> D -> B = 8
            And therefore A -> B = 6 is smaller and thus popped first.
            Now if D -> B = 3 then ...
              A -> C = 1   ,   C -> D = 2   ,   D -> B = 3  | Total Distance: A -> C -> D -> B = 6
            And in this case it wouldn't matter wich path is popped first as they would be both equally distant
            '''
            if curr_node in time_required_dict : continue # if the node is already visited, skip it

            time_required_dict[curr_node] = curr_node_time # record the shortest time to reach this node


            #----------------------------------------
            for to_node , to_node_time in adj_list[curr_node] :
                if to_node in time_required_dict : continue # if the node is already visited, skip it
                new_time : int = to_node_time + curr_node_time
                heapq.heappush( min_heap , [new_time , to_node] )
            #----------------------------------------
        #----------------------------------------

        max_time : int = max(time_required_dict.values())

        result : int = max_time if len(time_required_dict) == n else -1

        return result
    #-------------------------------------------------------------------------
#-------------------------------------------------------------------------
